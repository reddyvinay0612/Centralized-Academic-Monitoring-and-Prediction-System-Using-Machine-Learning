# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=camps-ml-development-secret-key-replace-in-production-32-chars

# Database Connection (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///camps.db
# Example PostgreSQL: postgresql://username:password@localhost:5432/camps_db

# Email Notification Settings (Flask-Mail)
# To use Gmail, generate an App Password in your Google Account security settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=CAMPS Alerts <alerts@camps-institution.edu>

# ML Thresholds & Paths
ML_MODEL_DIR=ml_engine/saved_models
ALERT_ATTENDANCE_THRESHOLD=75.0
ALERT_HIGH_RISK_PROBABILITY=0.60
REPORT_OUTPUT_DIR=reports_output
